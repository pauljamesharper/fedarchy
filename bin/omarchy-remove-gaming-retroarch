#!/bin/bash

# omarchy:summary=Remove RetroArch, its cores, and its config/saves. Leaves ~/Games/roms and ~/Games/bios alone.

set -e

omarchy-pkg-flatpak-drop org.libretro.RetroArch

rm -rf "$HOME/.var/app/org.libretro.RetroArch"

echo ""
echo "RetroArch and its cores have been removed."
echo "ROMs and BIOS files at ~/Games/roms and ~/Games/bios were left in place."
