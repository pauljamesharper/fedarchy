#!/bin/bash

# omarchy:summary=Launch the default editor selected via Omarchy defaults.
# omarchy:args=[--inline] <path>

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

editor=$(omarchy-default-editor --command) || editor="nvim"

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" "$@"
  else
    exec omarchy-launch-tui "$editor" "$@"
  fi
  ;;
emacs)
  # Open a frame on the Emacs daemon instead of cold-starting a second,
  # standalone Emacs. An empty -a starts the daemon on first use when
  # emacs.service isn't running it, so every later launch reuses it.
  # -u LD_PRELOAD sidesteps secureblue's hardened_malloc, which segfaults a
  # cold-started GUI frame; it's a no-op elsewhere.
  exec setsid uwsm-app -- env -u LD_PRELOAD emacsclient -c -a '' "$@"
  ;;
*)
  exec setsid uwsm-app -- "$editor" "$@"
  ;;
esac
