#!/bin/bash

# omarchy:summary=Install Lutris from Flathub, which bundles Wine and its runtimes.

set -e

echo "Installing Lutris..."
omarchy-pkg-flatpak-add net.lutris.Lutris

cat <<'TEXT'
Lutris will open and auto-fetch its Wine, DXVK and VKD3D runtimes in the background
(watch the bottom status bar). Once that finishes, click the + to add or install games.
TEXT

setsid uwsm-app -- gtk-launch net.lutris.Lutris >/dev/null 2>&1 &
