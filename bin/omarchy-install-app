#!/bin/bash

# omarchy:summary=Install a packaged app, surfacing the install in a floating terminal
# omarchy:args=<display-name> <[flatpak:|brew:|aur:]packages>
# omarchy:examples=omarchy install app 'LM Studio' lmstudio-bin

name="${1-}"
packages="${2-}"

if [[ -z $name || -z $packages ]]; then
  echo "Usage: omarchy-install-app <display-name> <packages>" >&2
  exit 1
fi

# A prefix picks the package source; bare names are distro packages.
case "$packages" in
flatpak:*) installer="omarchy-pkg-flatpak-add" packages="${packages#flatpak:}" ;;
brew:*) installer="omarchy-pkg-brew-add" packages="${packages#brew:}" ;;
aur:*) installer="omarchy-pkg-aur-add" packages="${packages#aur:}" ;;
*) installer="omarchy-pkg-add" ;;
esac

exec omarchy-launch-floating-terminal-with-presentation "echo 'Installing ${name}...'; ${installer} ${packages}"
