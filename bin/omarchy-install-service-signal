#!/bin/bash

# omarchy:summary=Install Signal and launch it.

set -e

# Signal Desktop ships no rpm, only a Debian/Ubuntu apt repo, so signal-desktop
# does not exist as a Fedora package. Use the official Flathub build instead.
echo "Installing Signal..."
flatpak install -y --user flathub org.signal.Signal

echo "Opening Signal..."
setsid uwsm-app -- flatpak run org.signal.Signal >/dev/null 2>&1 &

echo ""
echo "Signal has been installed."
