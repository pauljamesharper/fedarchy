#!/bin/bash

# omarchy:summary=Install 1Password and its Chromium extension.
# omarchy:requires-sudo=true

set -e

EXTENSION_ID="aeblfdkhhhdcdjpifhhbdiojplfjncoa"
POLICY_DIR="/etc/chromium/policies/managed"
WEBSTORE_UPDATE_URL="https://clients2.google.com/service/update2/crx"

# A managed policy under /etc rather than an external-extension file under
# /usr/share, which is read-only on atomic Fedora. normal_installed adds the
# extension but still lets the user remove it.
install_chromium_extension() {
  if omarchy-cmd-missing chromium-browser && omarchy-cmd-missing chromium; then
    echo "Chromium is not installed; skipping 1Password Chromium extension."
    return
  fi

  sudo mkdir -p "$POLICY_DIR"
  printf '{ "ExtensionSettings": { "%s": { "installation_mode": "normal_installed", "update_url": "%s" } } }\n' \
    "$EXTENSION_ID" "$WEBSTORE_UPDATE_URL" | sudo tee "$POLICY_DIR/1password.json" >/dev/null
  sudo chmod 644 "$POLICY_DIR/1password.json"
}

# 1Password is not in the Fedora repositories; it publishes its own signed one.
add_1password_repo() {
  sudo rpm --import https://downloads.1password.com/linux/keys/1password.asc
  cat <<'REPO' | sudo tee /etc/yum.repos.d/1password.repo >/dev/null
[1password]
name=1Password Stable Channel
baseurl=https://downloads.1password.com/linux/rpm/stable/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://downloads.1password.com/linux/keys/1password.asc
REPO
}

echo "Installing 1Password..."
if [[ $(uname -m) == "aarch64" ]]; then
  # The AUR PKGBUILD is x86_64-only, so omarchy-pkg-add fails outright here.
  # omarchy-install-1password takes the official arm64 tarball instead.
  omarchy-install-1password

  # The CLI does have an aarch64 build; not having it is not worth failing the
  # GUI install over.
  omarchy-pkg-add 1password-cli ||
    echo "1Password CLI could not be installed; the desktop app is fine without it."
else
  add_1password_repo
  omarchy-pkg-add 1password 1password-cli
fi

echo "Installing 1Password extension for Chromium..."
install_chromium_extension

echo "Opening 1Password..."
uwsm-app -- 1password >/dev/null 2>&1 &

echo ""
echo "1Password has been installed. Restart Chromium to load the browser extension."
