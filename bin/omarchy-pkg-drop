#!/bin/bash
# omarchy:summary=Remove packages with dnf
# omarchy:args=<packages...>

OMARCHY_INSTALL=${OMARCHY_INSTALL:-"$OMARCHY_PATH/install"}
source "$OMARCHY_INSTALL/helpers/packages.sh"

for pkg in "$@"; do
  omarchy_package_installed "$pkg" || continue

  if ! omarchy_remove_package "$pkg"; then
    echo -e "\033[31mError: Failed to remove $pkg\033[0m" >&2
    exit 1
  fi
done

exit 0
