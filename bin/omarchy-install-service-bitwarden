#!/bin/bash

# omarchy:summary=Install Bitwarden from Flathub and its CLI from Homebrew.

set -e

echo "Installing Bitwarden..."
omarchy-pkg-flatpak-add com.bitwarden.desktop

echo "Installing Bitwarden CLI..."
omarchy-pkg-brew-add bitwarden-cli

echo "Opening Bitwarden..."
setsid uwsm-app -- gtk-launch com.bitwarden.desktop >/dev/null 2>&1 &

echo ""
echo "Bitwarden has been installed."
