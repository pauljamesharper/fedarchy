#!/bin/bash

# omarchy:summary=Launch the default browser as determined by xdg-settings.
# omarchy:args=[url]
desktop_paths=(
  "$HOME/.local/share/applications"
  "$HOME/.local/share/flatpak/exports/share/applications"
  "/var/lib/flatpak/exports/share/applications"
  "$HOME/.nix-profile/share/applications"
  "/usr/local/share/applications"
  "/usr/share/applications"
)

resolve_desktop_file() {
  local desktop_id="$1"

  for base in "${desktop_paths[@]}"; do
    if [[ -f "$base/$desktop_id" ]]; then
      printf "%s\n" "$base/$desktop_id"
      return 0
    fi
  done

  return 1
}

# Returns the whole Exec= command line, not just its first word. A native
# entry's "Exec=chromium-browser %U" only ever had one word to begin with, but
# a Flatpak app's "Exec=/usr/bin/flatpak run --branch=... --command=... org.some.App %U"
# does not: truncating to the first token throws away everything after
# /usr/bin/flatpak, leaving nothing that actually launches the app. Field
# codes (%f/%F/%u/%U/%i/%c/%k) and Flatpak's "@@u ... @@" file-forwarding
# wrapper are for a desktop-file-aware launcher to substitute; stripped here
# since this script passes its own args instead.
resolve_exec() {
  local desktop_id="$1"
  local file
  local exec_line

  file="$(resolve_desktop_file "$desktop_id")" || return 1
  exec_line="$(sed -n 's/^Exec=//p' "$file" | head -n1)"
  exec_line="$(sed -E 's/@@[^@]*@@//g; s/%[fFuUick]//g' <<<"$exec_line")"
  exec_line="$(sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/ /g' <<<"$exec_line")"
  [[ -n "$exec_line" ]] || return 1
  printf "%s\n" "$exec_line"
}

pick_desktop_id() {
  local configured
  local candidate

  configured="$(xdg-settings get default-web-browser 2>/dev/null || true)"
  if [[ -n "$configured" ]] && resolve_desktop_file "$configured" >/dev/null; then
    printf "%s\n" "$configured"
    return 0
  fi

  for candidate in \
    chromium-browser.desktop \
    chromium.desktop \
    org.chromium.Chromium.desktop \
    google-chrome.desktop \
    com.google.Chrome.desktop \
    brave-browser.desktop \
    com.brave.Browser.desktop \
    microsoft-edge.desktop \
    com.microsoft.Edge.desktop \
    vivaldi-stable.desktop \
    com.vivaldi.Vivaldi.desktop \
    org.mozilla.firefox.desktop \
    firefox.desktop; do
    if resolve_desktop_file "$candidate" >/dev/null; then
      printf "%s\n" "$candidate"
      return 0
    fi
  done

  return 1
}

want_private=false
pass_args=()
for arg in "$@"; do
  if [[ "$arg" == "--private" ]]; then
    want_private=true
  else
    pass_args+=("$arg")
  fi
done

browser_exec=""
desktop_id="$(pick_desktop_id 2>/dev/null || true)"
if [[ -n "$desktop_id" ]]; then
  browser_exec="$(resolve_exec "$desktop_id" 2>/dev/null || true)"
fi

if [[ -z "$browser_exec" ]]; then
  for candidate in chromium-browser chromium firefox google-chrome brave-browser microsoft-edge vivaldi; do
    if command -v "$candidate" >/dev/null 2>&1; then
      browser_exec="$candidate"
      break
    fi
  done
fi

if [[ -z "$browser_exec" ]]; then
  # Flatpak may know the app even when no .desktop file resolved (a broken or
  # incomplete export). --command matches how the desktop files above launch
  # each app's actual binary rather than its default (which for Chromium is a
  # wrapper that behaves differently under file-forwarding).
  for app_id_pair in \
    "org.chromium.Chromium:/app/bin/chromium" \
    "org.mozilla.firefox:firefox" \
    "com.google.Chrome:chrome" \
    "com.brave.Browser:brave" \
    "com.microsoft.Edge:msedge" \
    "com.vivaldi.Vivaldi:vivaldi-bin"; do
    app_id="${app_id_pair%%:*}"
    app_command="${app_id_pair#*:}"
    if flatpak info --user "$app_id" >/dev/null 2>&1 || flatpak info "$app_id" >/dev/null 2>&1; then
      browser_exec="flatpak run --command=$app_command $app_id"
      break
    fi
  done
fi

if [[ -z "$browser_exec" ]]; then
  notify-send "Browser" "No supported browser found. Install Firefox or Chromium."
  exit 1
fi

read -r -a browser_exec_args <<<"$browser_exec"

if [[ $browser_exec == *firefox* ]]; then
  private_flag="--private-window"
elif [[ $browser_exec == *edge* ]]; then
  private_flag="--inprivate"
else
  private_flag="--incognito"
fi

if [[ "$want_private" == true ]]; then
  pass_args=("$private_flag" "${pass_args[@]}")
fi

exec setsid uwsm-app -- "${browser_exec_args[@]}" "${pass_args[@]}"
