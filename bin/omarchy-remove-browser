#!/bin/bash

# omarchy:summary=Remove a supported browser and clean up Omarchy browser defaults
# omarchy:args=<chrome|edge|brave|brave-origin|firefox|zen>
# omarchy:examples=omarchy remove browser firefox | omarchy remove browser brave
# omarchy:requires-sudo=true

set_fallback_default_browser() {
  local current_browser
  current_browser=$(env -u BROWSER xdg-settings get default-web-browser)

  if [[ $current_browser != $1 ]]; then
    return
  fi

  if [[ -f /usr/share/applications/chromium-browser.desktop ]]; then
    env -u BROWSER xdg-settings set default-web-browser chromium-browser.desktop || true
  fi
}

case $1 in
chrome)
  echo "Removing Chrome..."
  set_fallback_default_browser com.google.Chrome.desktop
  omarchy-pkg-flatpak-drop com.google.Chrome
  ;;
edge)
  echo "Removing Edge..."
  set_fallback_default_browser com.microsoft.Edge.desktop
  omarchy-pkg-flatpak-drop com.microsoft.Edge
  ;;
brave)
  echo "Removing Brave..."
  set_fallback_default_browser com.brave.Browser.desktop
  omarchy-pkg-flatpak-drop com.brave.Browser
  ;;
brave-origin)
  echo "Removing Brave Origin..."
  set_fallback_default_browser brave-origin.desktop
  omarchy-pkg-drop brave-origin
  rm -f ~/.config/brave-origin-flags.conf

  sudo rm -rf /etc/brave
  ;;
firefox)
  echo "Removing Firefox..."
  set_fallback_default_browser firefox.desktop
  omarchy-pkg-drop firefox
  ;;
zen)
  echo "Removing Zen..."
  set_fallback_default_browser app.zen_browser.zen.desktop
  omarchy-pkg-flatpak-drop app.zen_browser.zen
  ;;
*)
  echo "Usage: omarchy-remove-browser <chrome|edge|brave|brave-origin|firefox|zen>"
  exit 1
  ;;
esac
