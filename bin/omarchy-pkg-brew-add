#!/bin/bash

# omarchy:summary=Install command line tools with Homebrew, skipping ones already installed.
# omarchy:args=<formulae...>
# omarchy:examples=omarchy pkg brew-add helix ollama

(($# > 0)) || { echo "Usage: omarchy-pkg-brew-add <formulae...>" >&2; exit 1; }

for formula in "$@"; do
  brew list --formula "$formula" &>/dev/null && continue
  brew install "$formula" || exit 1
done
